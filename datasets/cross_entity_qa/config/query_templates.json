{
  "metadata": {
    "version": "1.0",
    "description": "Query template library for cross-entity QA generation",
    "phase": "B.2",
    "purpose": "Define parameterized query templates for each cluster type x difficulty combination"
  },

  "template_structure": {
    "description": "Standard structure for all query templates",
    "required_fields": {
      "template_id": "Unique identifier (format: {cluster_type}_{difficulty}_{variant})",
      "cluster_type": "Compatible cluster type from cluster_types.json",
      "difficulty": "easy | medium | hard",
      "k_range": {"min": "Minimum target K", "max": "Maximum target K"},
      "pattern": "Natural language pattern with {placeholder} slots",
      "slots": "Object mapping each placeholder to its definition",
      "answer_spec": {
        "type": "list | count | comparison | aggregation | narrative",
        "aggregation_method": "How to combine entity answers",
        "completeness_criteria": "What constitutes a complete answer"
      },
      "difficulty_params": {
        "lexical_overlap_target": "0.0-1.0 scale",
        "reasoning_hops": "Number of inference steps",
        "indirection_level": "direct | descriptive | implicit"
      },
      "validation": {
        "sparql_pattern": "Template SPARQL for ground truth verification",
        "answerability_criteria": "Conditions for valid query",
        "failure_modes": "List of common issues to check"
      }
    }
  },

  "templates": {
    "categorical": {
      "easy": [
        {
          "template_id": "categorical_easy_enumeration",
          "cluster_type": "categorical",
          "difficulty": "easy",
          "k_range": {"min": 5, "max": 20},
          "pattern": "List all {entity_type_plural} that {constraint_description}.",
          "slots": {
            "entity_type_plural": "Plural form of entity type (e.g., 'countries', 'companies', 'scientists')",
            "constraint_description": "Description of the constraint (e.g., 'have hosted the Summer Olympics')"
          },
          "alternative_phrasings": [
            "What are all the {entity_type_plural} that {constraint_description}?",
            "Name the {entity_type_plural} that {constraint_description}.",
            "Which {entity_type_plural} {constraint_description}?"
          ],
          "answer_spec": {
            "type": "list",
            "aggregation_method": "complete_enumeration",
            "completeness_criteria": "All entities matching constraint must be included"
          },
          "difficulty_params": {
            "lexical_overlap_target": [0.7, 0.8],
            "reasoning_hops": 1,
            "indirection_level": "direct"
          },
          "validation": {
            "sparql_pattern": "SELECT ?entity WHERE { ?entity wdt:P31 wd:{entity_type} . ?entity {constraint_property} {constraint_value} . }",
            "answerability_criteria": "Entity type and constraint appear in Wikipedia passages",
            "failure_modes": ["constraint_too_vague", "entity_type_mismatch", "incomplete_wikidata"]
          }
        }
      ],
      "medium": [
        {
          "template_id": "categorical_medium_attribute",
          "cluster_type": "categorical",
          "difficulty": "medium",
          "k_range": {"min": 5, "max": 15},
          "pattern": "What are the {attribute_plural} of {entity_type_plural} that {constraint_description}?",
          "slots": {
            "attribute_plural": "Attribute to collect (e.g., 'founding dates', 'populations', 'headquarters')",
            "entity_type_plural": "Plural form of entity type",
            "constraint_description": "Description of the constraint"
          },
          "alternative_phrasings": [
            "For each {entity_type} that {constraint_description}, what is their {attribute}?",
            "Find the {attribute_plural} for all {entity_type_plural} that {constraint_description}."
          ],
          "answer_spec": {
            "type": "list",
            "aggregation_method": "entity_attribute_pairs",
            "completeness_criteria": "Each entity should have its attribute value listed"
          },
          "difficulty_params": {
            "lexical_overlap_target": [0.4, 0.5],
            "reasoning_hops": 2,
            "indirection_level": "descriptive"
          },
          "validation": {
            "sparql_pattern": "SELECT ?entity ?attribute WHERE { ?entity wdt:P31 wd:{entity_type} . ?entity {constraint_property} {constraint_value} . ?entity {attribute_property} ?attribute . }",
            "answerability_criteria": "Attribute values must be present in entity Wikipedia passages",
            "failure_modes": ["attribute_not_in_passage", "partial_coverage", "ambiguous_attribute"]
          }
        }
      ],
      "hard": [
        {
          "template_id": "categorical_hard_aggregation",
          "cluster_type": "categorical",
          "difficulty": "hard",
          "k_range": {"min": 5, "max": 15},
          "pattern": "What is the {aggregation} {attribute} among {indirect_description}?",
          "slots": {
            "aggregation": "Aggregation function (e.g., 'average', 'total', 'highest', 'lowest')",
            "attribute": "Attribute to aggregate (e.g., 'GDP', 'population', 'revenue')",
            "indirect_description": "Indirect reference to entity set (e.g., 'the world's largest economies')"
          },
          "alternative_phrasings": [
            "Calculate the {aggregation} {attribute} for {indirect_description}.",
            "Among {indirect_description}, what is the {aggregation} {attribute}?"
          ],
          "answer_spec": {
            "type": "aggregation",
            "aggregation_method": "compute_aggregate",
            "completeness_criteria": "All relevant entities must be included in computation"
          },
          "difficulty_params": {
            "lexical_overlap_target": [0.2, 0.3],
            "reasoning_hops": 3,
            "indirection_level": "implicit"
          },
          "validation": {
            "sparql_pattern": "SELECT ({agg_function}(?value) AS ?result) WHERE { ?entity wdt:P31 wd:{entity_type} . ?entity {constraint_property} {constraint_value} . ?entity {attribute_property} ?value . }",
            "answerability_criteria": "All values needed for aggregation must be extractable",
            "failure_modes": ["missing_values", "implicit_reference_unclear", "aggregation_undefined"]
          }
        }
      ]
    },

    "creative_ensemble": {
      "easy": [
        {
          "template_id": "creative_ensemble_easy_cast",
          "cluster_type": "creative_ensemble",
          "difficulty": "easy",
          "k_range": {"min": 5, "max": 30},
          "pattern": "Who are the {role_plural} in {work_title}?",
          "slots": {
            "role_plural": "Role type (e.g., 'main cast members', 'actors', 'performers')",
            "work_title": "Title of creative work (e.g., 'The Godfather', 'Abbey Road')"
          },
          "alternative_phrasings": [
            "List the {role_plural} of {work_title}.",
            "Name all the {role_plural} who appeared in {work_title}.",
            "Which {role_plural} were featured in {work_title}?"
          ],
          "answer_spec": {
            "type": "list",
            "aggregation_method": "complete_enumeration",
            "completeness_criteria": "All persons with specified role should be listed"
          },
          "difficulty_params": {
            "lexical_overlap_target": [0.7, 0.9],
            "reasoning_hops": 1,
            "indirection_level": "direct"
          },
          "validation": {
            "sparql_pattern": "SELECT ?person WHERE { wd:{work_qid} wdt:P161 ?person . }",
            "answerability_criteria": "Work title appears in passages about cast members",
            "failure_modes": ["work_not_found", "incomplete_cast_data", "role_ambiguity"]
          }
        }
      ],
      "medium": [
        {
          "template_id": "creative_ensemble_medium_crossref",
          "cluster_type": "creative_ensemble",
          "difficulty": "medium",
          "k_range": {"min": 5, "max": 20},
          "pattern": "What {attribute_plural} do the {role_plural} of {work_title} have?",
          "slots": {
            "attribute_plural": "Attribute to collect (e.g., 'nationalities', 'birth years', 'alma maters')",
            "role_plural": "Role type",
            "work_title": "Title of creative work"
          },
          "alternative_phrasings": [
            "What are the {attribute_plural} of {role_plural} in {work_title}?",
            "For the {role_plural} of {work_title}, list their {attribute_plural}."
          ],
          "answer_spec": {
            "type": "list",
            "aggregation_method": "entity_attribute_pairs",
            "completeness_criteria": "Each ensemble member should have attribute listed"
          },
          "difficulty_params": {
            "lexical_overlap_target": [0.4, 0.6],
            "reasoning_hops": 2,
            "indirection_level": "descriptive"
          },
          "validation": {
            "sparql_pattern": "SELECT ?person ?attr WHERE { wd:{work_qid} wdt:P161 ?person . ?person {attr_property} ?attr . }",
            "answerability_criteria": "Attributes must appear in biographical sections",
            "failure_modes": ["attribute_not_in_bio", "incomplete_ensemble", "attribute_missing"]
          }
        }
      ],
      "hard": [
        {
          "template_id": "creative_ensemble_hard_fanout",
          "cluster_type": "creative_ensemble",
          "difficulty": "hard",
          "k_range": {"min": 5, "max": 15},
          "pattern": "For each {role} in {work_title}, what other {work_type_plural} have they {participation_verb}?",
          "slots": {
            "role": "Role type (singular, e.g., 'lead actor', 'main performer')",
            "work_title": "Title of creative work",
            "work_type_plural": "Type of related works (e.g., 'films', 'albums', 'TV series')",
            "participation_verb": "Participation (e.g., 'starred in', 'directed', 'produced')"
          },
          "alternative_phrasings": [
            "What are the other {work_type_plural} that each {role} from {work_title} has {participation_verb}?",
            "List the {work_type_plural} by each {role} in {work_title}."
          ],
          "answer_spec": {
            "type": "list",
            "aggregation_method": "nested_entity_lists",
            "completeness_criteria": "Each ensemble member should have related works listed"
          },
          "difficulty_params": {
            "lexical_overlap_target": [0.2, 0.4],
            "reasoning_hops": 3,
            "indirection_level": "implicit"
          },
          "validation": {
            "sparql_pattern": "SELECT ?person ?otherWork WHERE { wd:{work_qid} wdt:P161 ?person . ?otherWork wdt:P161 ?person . FILTER(?otherWork != wd:{work_qid}) }",
            "answerability_criteria": "Filmography/discography must appear in passages",
            "failure_modes": ["incomplete_filmography", "work_type_mismatch", "too_many_results"]
          }
        }
      ]
    },

    "award_recognition": {
      "easy": [
        {
          "template_id": "award_recognition_easy_recipients",
          "cluster_type": "award_recognition",
          "difficulty": "easy",
          "k_range": {"min": 3, "max": 15},
          "pattern": "Who received the {award_name} in {time_period}?",
          "slots": {
            "award_name": "Name of award (e.g., 'Nobel Prize in Physics', 'Academy Award for Best Picture')",
            "time_period": "Year or range (e.g., '2021', '2010-2020')"
          },
          "alternative_phrasings": [
            "List the {award_name} winners from {time_period}.",
            "Who won the {award_name} during {time_period}?",
            "Name all {award_name} recipients in {time_period}."
          ],
          "answer_spec": {
            "type": "list",
            "aggregation_method": "complete_enumeration",
            "completeness_criteria": "All recipients in time period must be listed"
          },
          "difficulty_params": {
            "lexical_overlap_target": [0.7, 0.9],
            "reasoning_hops": 1,
            "indirection_level": "direct"
          },
          "validation": {
            "sparql_pattern": "SELECT ?person WHERE { ?person wdt:P166 wd:{award_qid} . ?person p:P166 ?stmt . ?stmt pq:P585 ?date . FILTER(YEAR(?date) >= {year_start} && YEAR(?date) <= {year_end}) }",
            "answerability_criteria": "Award name and year appear in recipient passages",
            "failure_modes": ["missing_year_qualifier", "award_variant_mismatch", "incomplete_recipient_list"]
          }
        }
      ],
      "medium": [
        {
          "template_id": "award_recognition_medium_attributes",
          "cluster_type": "award_recognition",
          "difficulty": "medium",
          "k_range": {"min": 3, "max": 12},
          "pattern": "What {attribute_plural} do {award_name} recipients from {time_period} have?",
          "slots": {
            "attribute_plural": "Attribute (e.g., 'universities', 'nationalities', 'research areas')",
            "award_name": "Name of award",
            "time_period": "Year or range"
          },
          "alternative_phrasings": [
            "Which {attribute_plural} are associated with {award_name} winners from {time_period}?",
            "For {award_name} recipients in {time_period}, what are their {attribute_plural}?"
          ],
          "answer_spec": {
            "type": "list",
            "aggregation_method": "entity_attribute_pairs",
            "completeness_criteria": "Attribute for each recipient should be listed"
          },
          "difficulty_params": {
            "lexical_overlap_target": [0.4, 0.5],
            "reasoning_hops": 2,
            "indirection_level": "descriptive"
          },
          "validation": {
            "sparql_pattern": "SELECT ?person ?attr WHERE { ?person wdt:P166 wd:{award_qid} . ?person p:P166 ?stmt . ?stmt pq:P585 ?date . ?person {attr_property} ?attr . FILTER(YEAR(?date) >= {year_start}) }",
            "answerability_criteria": "Attributes must be in biographical sections",
            "failure_modes": ["attribute_not_mentioned", "institutional_name_variations", "partial_coverage"]
          }
        }
      ],
      "hard": [
        {
          "template_id": "award_recognition_hard_comparative",
          "cluster_type": "award_recognition",
          "difficulty": "hard",
          "k_range": {"min": 5, "max": 15},
          "pattern": "How do the {attribute_plural} of {award_name} winners compare across {dimension}?",
          "slots": {
            "attribute_plural": "Attribute to compare (e.g., 'research fields', 'career trajectories')",
            "award_name": "Name of award",
            "dimension": "Comparison dimension (e.g., 'decades', 'countries', 'disciplines')"
          },
          "alternative_phrasings": [
            "What patterns exist in the {attribute_plural} of {award_name} recipients by {dimension}?",
            "Compare the {attribute_plural} of {award_name} winners across different {dimension}."
          ],
          "answer_spec": {
            "type": "comparison",
            "aggregation_method": "dimensional_comparison",
            "completeness_criteria": "Comparison must cover multiple groups along dimension"
          },
          "difficulty_params": {
            "lexical_overlap_target": [0.2, 0.3],
            "reasoning_hops": 4,
            "indirection_level": "implicit"
          },
          "validation": {
            "sparql_pattern": "SELECT ?person ?attr ?dimension WHERE { ?person wdt:P166 wd:{award_qid} . ?person {attr_property} ?attr . ?person {dimension_property} ?dimension . }",
            "answerability_criteria": "Sufficient data points for meaningful comparison",
            "failure_modes": ["insufficient_data_points", "dimension_not_comparable", "analysis_too_complex"]
          }
        }
      ]
    },

