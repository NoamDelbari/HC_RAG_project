  "slot_value_guidelines": {
    "entity_type_plural": {
      "description": "Use natural plural forms matching Wikipedia article titles",
      "examples": ["countries", "companies", "films", "scientists", "universities"]
    },
    "constraint_description": {
      "description": "Natural language description matching Wikidata property-value pairs",
      "examples": ["have hosted the Summer Olympics", "are members of the EU", "were founded before 1900"]
    },
    "attribute_plural": {
      "description": "Attributes that appear in Wikipedia articles",
      "examples": ["founding dates", "populations", "headquarters locations", "nationalities"]
    },
    "time_period": {
      "description": "Specific years, ranges, or natural time expressions",
      "examples": ["2021", "2010-2020", "the 1990s", "the 21st century"]
    },
    "work_title": {
      "description": "Exact title of creative work as appears in Wikipedia",
      "examples": ["The Godfather", "Inception", "Abbey Road"]
    },
    "organization": {
      "description": "Organization name as appears in Wikipedia",
      "examples": ["MIT", "Goldman Sachs", "Google", "the United Nations"]
    },
    "geographic_region": {
      "description": "Named geographic area with clear boundaries",
